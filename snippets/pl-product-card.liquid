{% comment %}
  Renders a Purelane product card.

  Shared by the Shop grid, Best-selling combos and Bundles sections so the card
  markup and styling exist in exactly one place.

  Accepts:
  - product: {Object} Product Liquid object (required)
  - badge: {String} Optional override for the corner pill. When blank, falls back
      to the product's `custom.card_badge` metafield. A sold-out product always
      shows "Sold out" instead, since availability beats a marketing label.
  - show_rating: {Boolean} Render the rating row. Reads the standard
      `reviews.rating` / `reviews.rating_count` metafields, so it stays accurate
      when a reviews app writes to them and simply hides when unset.
  - show_button: {Boolean} Render the add-to-cart form. Default true.
  - button_label: {String} Optional CTA label override.
  - card_class: {String} Extra classes for the outer element.

  Usage:
  {% render 'pl-product-card', product: product, show_rating: true %}
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign price = variant.price
  assign compare = variant.compare_at_price
  assign available = product.available

  assign badge_label = badge
  if badge_label == blank
    assign badge_label = product.metafields.custom.card_badge.value
  endif

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value

  assign cta = button_label | default: 'Add to cart'
-%}

<article class="pl-glass pl-card {{ card_class }}">
  <div class="pl-card__shot{% if product.featured_image == blank %} pl-card__shot--empty{% endif %}">
    {%- unless available -%}
      <span class="pl-card__pill pl-card__pill--soldout">Sold out</span>
    {%- else -%}
      {%- if badge_label != blank -%}
        <span class="pl-card__pill">{{ badge_label }}</span>
      {%- endif -%}
    {%- endunless -%}

    {%- if product.featured_image != blank -%}
      {{
        product.featured_image
        | image_url: width: 400
        | image_tag: loading: 'lazy', widths: '160, 240, 320, 400', sizes: '(min-width: 860px) 240px, 45vw', alt: product.featured_image.alt | default: product.title
      }}
    {%- else -%}
      {%- comment -%}
        No image on the product. Rather than leaving a blank box, label it so the
        card still reads as a real product and the layout height is preserved.
      {%- endcomment -%}
      <span aria-hidden="true">Image<br>coming soon</span>
    {%- endif -%}
  </div>

  <h3 class="pl-card__title">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {%- if show_rating and rating != blank -%}
    <div class="pl-card__rate">
      <b>&#9733; {{ rating | round: 1 }}</b>
      {%- if rating_count != blank -%}
        <span>&middot; {{ rating_count }} {{ rating_count | pluralize: 'review', 'reviews' }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pl-card__price">
    <strong>{{ price | money }}</strong>
    {%- if compare > price -%}
      <s>{{ compare | money }}</s>
      {%- assign pct_off = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
      <em>{{ pct_off }}% off</em>
    {%- endif -%}
  </div>

  {%- unless show_button == false -%}
    {%- if available -%}
      {%- form 'product', product, class: 'pl-card__form', id: null -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="pl-btn pl-btn--ghost pl-btn--sm pl-btn--full">
          {{ cta }}<span class="visually-hidden"> - {{ product.title }}</span>
        </button>
      {%- endform -%}
    {%- else -%}
      <button type="button" class="pl-btn pl-btn--ghost pl-btn--sm pl-btn--full" disabled>
        Sold out<span class="visually-hidden"> - {{ product.title }}</span>
      </button>
    {%- endif -%}
  {%- endunless -%}
</article>
