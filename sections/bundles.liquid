{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section id="bundles" class="pl-scope" style="background:var(--paper-2)">
  <div class="wrap">
    <div class="shead rv">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="display d2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.description != blank -%}
        <p class="small" style="max-width:34ch;margin:0">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="tiers rv">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bundle = block.settings.bundle_product
          assign v = bundle.selected_or_first_available_variant
          assign qty = block.settings.quantity
          assign per = 0
          if qty > 0
            assign per = v.price | divided_by: qty
          endif
        -%}
        <div class="tier{% if block.settings.highlight %} tier--on{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
          {%- if qty > 0 -%}
            <div class="n">{{ qty }}<span>{{ qty | pluralize: 'Product', 'Products' }}</span></div>
          {%- endif -%}
          {%- if bundle != blank -%}
            <div class="amt">{{ v.price | money }}</div>
            {%- if per > 0 -%}<div class="small">{{ per | money }} each</div>{%- endif -%}
          {%- endif -%}

          {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
          {%- if block.settings.features != blank -%}
            <ul>
              {%- for line in lines -%}
                {%- assign clean = line | strip -%}
                {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if bundle != blank -%}
            {%- if bundle.available -%}
              {%- form 'product', bundle, class: 'pl-form' -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn {% if block.settings.highlight %}btn--onDark{% else %}btn--line{% endif %}">
                  {{ block.settings.button_label | default: 'Build this box' }}
                  <span class="visually-hidden"> - {{ block.settings.tag | default: bundle.title }}</span>
                </button>
              {%- endform -%}
            {%- else -%}
              <button type="button" class="btn btn--line" disabled style="opacity:.45">Sold out</button>
            {%- endif -%}
          {%- elsif request.design_mode -%}
            <p class="small">Pick the bundle product in this block's settings.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Build a box",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your own" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Pick the products,<br>we'll price the box" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Mix across kitchen, laundry, home and skin. One flat price, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "Its live price drives both the headline price and the per-product figure." },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "range", "id": "quantity", "min": 1, "max": 8, "step": 1, "label": "Products in this tier", "default": 2 },
        { "type": "textarea", "id": "features", "label": "Features", "info": "One per line.", "default": "Any two products\nFree shipping across India" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" }
      ]
    }
  ],
  "presets": [ { "name": "Build a box", "blocks": [ { "type": "tier" }, { "type": "tier", "settings": { "highlight": true } }, { "type": "tier" } ] } ]
}
{% endschema %}
