{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section id="reviews" class="pl-scope">
  <div class="wrap">
    <div class="shead rv">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="display d2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.aggregate != blank -%}
        <div class="small">
          <b style="font-family:var(--display);font-size:26px;color:var(--ink);font-weight:400">{{ section.settings.aggregate }}</b>
          {{ section.settings.aggregate_note }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="quotes rv">
        {%- for block in section.blocks -%}
          <blockquote class="quote" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
              </div>
            {%- endif -%}
            <p>{{ block.settings.body }}</p>
            <footer>
              {{ block.settings.author | default: 'Verified buyer' }}
              {%- if block.settings.product != blank %} &middot; {{ block.settings.product.title }}{% endif -%}
            </footer>
          </blockquote>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "From the people using it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What they said" },
    { "type": "text", "id": "aggregate", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "aggregate_note", "label": "Note", "default": "from 8,000+ reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "body", "label": "Review", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Author", "default": "Verified buyer" },
        { "type": "product", "id": "product", "label": "Product reviewed", "info": "Linked so the attribution follows a rename." }
      ]
    }
  ],
  "presets": [ { "name": "Reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
