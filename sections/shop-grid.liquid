{{ 'purelane.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section class="pl-scope pl-sec" id="shop">
  <div class="pl-wrap">
    <div class="pl-panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <ul
        class="pl-shelf"
        style="--pl-cols-desktop:{{ section.settings.columns_desktop }};--pl-cols-mobile:{{ section.settings.columns_mobile }}"
        role="list"
      >
        {%- for product in collection.products limit: limit -%}
          <li>
            {% render 'pl-product-card', product: product, show_rating: section.settings.show_rating %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%}
        Empty state. A merchant who hasn't picked a collection yet, or picked an
        empty one, should see why the section looks blank rather than a void.
        Only rendered inside the theme editor so customers never see it.
      {%- endcomment -%}
      {%- if request.design_mode -%}
        <p class="pl-body-s" style="text-align:center">
          Choose a collection with products in the section settings to populate this grid.
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "info": "Reads the reviews.rating metafield. The row is hidden automatically on products that have no rating yet.",
      "default": true
    }
  ],
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}
