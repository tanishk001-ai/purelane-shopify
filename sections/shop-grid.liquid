{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section id="shop" class="pl-scope">
  <div class="wrap">
    <div class="shead rv">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="display d2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="qlink" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_tabs and section.blocks.size > 0 -%}
      <div class="tabs rv" role="tablist" data-tabs data-target="#ShopGrid-{{ section.id }}">
        <button class="tab" role="tab" type="button" data-tab="all" aria-selected="true">All</button>
        {%- for block in section.blocks -%}
          <button class="tab" role="tab" type="button" data-tab="{{ block.settings.product_type | handle }}" aria-selected="false" {{ block.shopify_attributes }}>
            {{ block.settings.label | default: block.settings.product_type }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign products = section.settings.collection.products -%}
    {%- if products.size > 0 -%}
      <div class="grid rv" id="ShopGrid-{{ section.id }}">
        {%- for product in products limit: section.settings.products_to_show -%}
          <div data-type="{{ product.type | handle }}">
            {% render 'pl-card', product: product, show_rating: section.settings.show_rating %}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="small">Choose a collection in the section settings to populate this grid.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything a home needs" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all products" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "show_rating", "label": "Show ratings", "default": true, "info": "Reads the reviews.rating metafield. Hidden automatically on products with no rating." },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category filter", "default": true }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Category filter",
      "settings": [
        { "type": "text", "id": "product_type", "label": "Product type", "info": "Must match the product type set on your products, e.g. Kitchen.", "default": "Kitchen" },
        { "type": "text", "id": "label", "label": "Tab label" }
      ]
    }
  ],
  "presets": [ { "name": "Shop grid", "blocks": [ { "type": "filter" }, { "type": "filter" }, { "type": "filter" } ] } ]
}
{% endschema %}
