{{ 'purelane.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign stage = section.blocks | where: 'type', 'stage'
  assign trust = section.blocks | where: 'type', 'trust'
-%}

{%- if section.settings.announcement != blank -%}
  <div class="ann">{{ section.settings.announcement }}</div>
{%- endif -%}

<div class="wrap hero">
  <div class="hgrid">
    <div class="rv in">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h1 class="display d1">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="hcta">
        {%- if section.settings.btn1_label != blank -%}
          <a class="btn btn--fill" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a class="btn btn--line" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if stage.size > 0 -%}
      <div class="rv in">
        <div class="hstage" data-stage role="group" aria-roledescription="carousel" aria-label="Featured products">
          {%- for block in stage -%}
            {%- assign p = block.settings.product -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <figure {% if forloop.first %}class="on"{% endif %} data-slide
              data-label="{{ block.settings.label | default: p.title | escape }}"
              data-price="{{ v.price | money }}"
              data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}"
              {% unless forloop.first %}aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
              {%- if p.featured_image != blank -%}
                {%- if forloop.first -%}
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'eager', widths: '360, 520, 700', alt: p.title }}
                {%- else -%}
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360, 520, 700', alt: p.title }}
                {%- endif -%}
              {%- endif -%}
            </figure>
          {%- endfor -%}

          <div class="hmeta">
            <div>
              <span class="kicker" data-stage-label></span>
              <strong data-stage-price></strong>
            </div>
            {%- if stage.size > 1 -%}
              <div class="hdots" data-dots>
                {%- for block in stage -%}
                  <button type="button" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="Show product {{ forloop.index }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if trust.size > 0 -%}
    <dl class="trust rv">
      {%- for block in trust -%}
        <div {{ block.shopify_attributes }}>
          <dt>{{ block.settings.title }}</dt>
          <dd>{{ block.settings.body }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  {%- endif -%}
</div>

<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "html", "id": "announcement", "label": "Announcement bar", "default": "Free shipping on orders over ₹499 · <b>Refill packs now shipping</b>", "info": "Leave blank to hide." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Plant-based homecare" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Clean that<br><em>lasts</em>", "info": "Wrap a word in <em> to set it in the accent colour." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Made from plants, made for the grime that actually turns up in a home. Kind to the people in it, and to everything downstream." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop the range" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "How it's made" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Featured product",
      "limit": 5,
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Its image and live price drive this slide." },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the product title." }
      ]
    },
    {
      "type": "trust",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Plant powered" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Coconut and corn derived, never petrochemical." }
      ]
    }
  ],
  "presets": [
    { "name": "Hero", "blocks": [ { "type": "stage" }, { "type": "stage" }, { "type": "stage" }, { "type": "trust" }, { "type": "trust" }, { "type": "trust" }, { "type": "trust" } ] }
  ]
}
{% endschema %}
