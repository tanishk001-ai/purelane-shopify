{%- liquid
  assign stage_blocks = section.blocks | where: 'type', 'stage_product'
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign stage_count = stage_blocks.size
-%}

<section class="pl-hero-wrap" id="Hero-{{ section.id }}">
  <div class="pl-hero">
    <div class="pl-hero-grid">

      {%- if badge_blocks.size > 0 -%}
        <div class="pl-badges" aria-label="Product promises">
          {%- for block in badge_blocks -%}
            <div class="pl-badge" {{ block.shopify_attributes }}>
              <span class="pl-badge__icon">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="pl-hero-copy">
        <h1 class="pl-h1">{{ section.settings.heading }}</h1>

        <div class="pl-rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>

        {%- if section.settings.subheading != blank -%}
          <p class="pl-lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="pl-hero-cta">
          {%- if section.settings.primary_button_label != blank -%}
            <a class="pl-btn pl-btn--primary" href="{{ section.settings.primary_button_link | default: '#' }}">
              {{ section.settings.primary_button_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            <a class="pl-btn pl-btn--ghost" href="{{ section.settings.secondary_button_link | default: '#' }}">
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if badge_blocks.size > 0 -%}
          <div class="pl-badgestrip">
            {%- for block in badge_blocks -%}
              <div class="pl-badgestrip__item">
                <span class="pl-badge__icon" style="background:none;border:none;width:auto;height:auto;margin:0 auto 6px;display:block">
                  {%- case block.settings.icon -%}
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                  {%- endcase -%}
                </span>
                {{ block.settings.label }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if stage_count > 0 -%}
        <div class="pl-stage-outer">
          <div
            class="pl-stage"
            data-pl-stage
            data-section-id="{{ section.id }}"
            role="group"
            aria-roledescription="carousel"
            aria-label="{{ section.settings.heading | strip_html | default: 'Featured pricing' }}"
          >
            {%- for block in stage_blocks -%}
              {%- liquid
                assign p = block.settings.product
                assign variant = p.selected_or_first_available_variant
                assign compare = variant.compare_at_price
                assign price = variant.price
                assign pack_size = forloop.index
              -%}
              <div
                class="pl-slide{% if forloop.first %} is-active{% endif %}"
                data-pl-slide
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="pl-slide__stack pl-slide__stack--{{ pack_size }}">
                  {%- for i in (1..pack_size) -%}
                    {%- if p != blank -%}
                      {%- if p.featured_image != blank -%}
                        {%- liquid
                          assign img_loading = 'lazy'
                          if forloop.parentloop.first and forloop.first
                            assign img_loading = 'eager'
                          endif
                        -%}
                        {{
                          p.featured_image
                          | image_url: width: 400
                          | image_tag: class: 'pl-slide__img', loading: img_loading, alt: p.title, widths: '200, 300, 400'
                        }}
                      {%- else -%}
                        <div class="pl-slide__img" style="background:rgba(236,230,247,.1);border:1px dashed rgba(236,230,247,.3);border-radius:12px;width:120px;height:200px" role="img" aria-label="{{ p.title | default: 'Product image not set' }}"></div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if p != blank -%}
                  <div class="pl-ptag">
                    <span class="pl-ptag__label">{{ block.settings.label | default: p.title }}</span>
                    <span class="pl-ptag__val">
                      <strong>{{ price | money }}</strong>
                      {%- if compare > price -%}<s>{{ compare | money }}</s>{%- endif -%}
                    </span>
                    {%- if compare > price -%}
                      {%- assign pct_off = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
                      <span class="pl-ptag__cut">{{ pct_off }}% off</span>
                    {%- elsif block.settings.badge_text != blank -%}
                      <span class="pl-ptag__cut">{{ block.settings.badge_text }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if stage_count > 1 -%}
            <div class="pl-dots" data-pl-dots role="tablist" aria-label="Show pricing tiers">
              {%- for block in stage_blocks -%}
                <button
                  type="button"
                  role="tab"
                  aria-controls="pl-slide-{{ section.id }}-{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Show {{ forloop.index }} product{% if forloop.index > 1 %}s{% endif %}"
                  data-pl-dot
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{%- if stage_count > 1 -%}
  <script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That<br><em>Lasts</em>",
      "info": "Wrap the accent word in <em> tags to render it in the accent colour, matching the design."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "stage_product",
      "name": "Pricing stage",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Its featured image and price/compare-at price are shown. Add up to 3 of this block to match the 1 → 2 → 3 product crossfade in the design."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tag label",
          "info": "Shown above the price, e.g. \"Single bottle\" or \"Any 2 products\". Defaults to the product title if left blank.",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (used only if the product has no compare-at price)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant powered" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Safe for kids & pets" } },
        { "type": "badge", "settings": { "icon": "spark", "label": "Zero harsh chemicals" } },
        { "type": "stage_product" }
      ]
    }
  ]
}
{% endschema %}
