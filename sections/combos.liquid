{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section id="combos" class="pl-scope">
  <div class="wrap">
    <div class="shead rv">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="display d2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.hint != blank -%}<span class="small">{{ section.settings.hint }}</span>{%- endif -%}
    </div>
  </div>

  <div class="wrap rv">
    <div class="rail" role="list" aria-label="{{ section.settings.heading | strip_html }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bundle = block.settings.bundle_product
          assign v = bundle.selected_or_first_available_variant

          # Components come straight off the block settings as product objects.
          # Never resolved through all_products, which Shopify caps at 20
          # lookups per page and would silently drop the later cards.
          assign total = 0
          assign count = 0
          for n in (1..5)
            assign key = 'product_' | append: n
            assign c = block.settings[key]
            if c != blank
              assign total = total | plus: c.selected_or_first_available_variant.price
              assign count = count | plus: 1
            endif
          endfor
          assign savings = total | minus: v.price
        -%}
        <article class="combo" role="listitem" {{ block.shopify_attributes }}>
          <div class="combo__top">
            {%- if savings > 0 -%}<span class="combo__save">Save {{ savings | money }}</span>{%- endif -%}
            <div class="combo__stack">
              {%- for n in (1..5) -%}
                {%- assign key = 'product_' | append: n -%}
                {%- assign c = block.settings[key] -%}
                {%- if c != blank and c.featured_image != blank -%}
                  {{ c.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 220, 300', sizes: '110px', alt: c.title }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="combo__body">
            <h3>{{ block.settings.title | default: bundle.title }}</h3>
            {%- if block.settings.description != blank -%}<p>{{ block.settings.description }}</p>{%- endif -%}
            {%- if bundle != blank -%}
              <div class="prow">
                <b>{{ v.price | money }}</b>
                {%- if total > v.price -%}<s>{{ total | money }}</s>{%- endif -%}
              </div>
              {%- if bundle.available -%}
                {%- form 'product', bundle, class: 'pl-form' -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn btn--fill btn--sm">{{ block.settings.button_label | default: 'Add set to cart' }}
                    <span class="visually-hidden"> - {{ block.settings.title | default: bundle.title }}</span></button>
                {%- endform -%}
              {%- else -%}
                <button type="button" class="btn btn--line btn--sm" disabled style="opacity:.45">Sold out</button>
              {%- endif -%}
            {%- elsif request.design_mode -%}
              <p class="small">Pick the bundle product in this block's settings.</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sets",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built sets" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Bought together,<br>priced together" },
    { "type": "text", "id": "hint", "label": "Swipe hint", "default": "Swipe for more →" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Set",
      "settings": [
        { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "The real product customers buy. Its live price and availability drive this card." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the bundle product's title." },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "header", "content": "What's inside" },
        { "type": "paragraph", "content": "These supply the image stack and the comparison price. Savings is calculated from their live prices, so it never goes stale." },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "product", "id": "product_5", "label": "Product 5" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add set to cart" }
      ]
    }
  ],
  "presets": [ { "name": "Sets", "blocks": [ { "type": "combo" }, { "type": "combo" }, { "type": "combo" } ] } ]
}
{% endschema %}
