{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="news pl-scope">
  <div class="wrap" style="display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;align-items:center">
    <div class="rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker" style="color:rgba(251,248,242,.68)">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="display d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    <div class="rv">
      {%- if section.settings.body != blank -%}
        <p class="lede" style="color:rgba(251,248,242,.85);margin:0">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- form 'customer', class: 'nform' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}"
          aria-label="{{ section.settings.placeholder }}" required>
        <button type="submit" class="btn btn--onDark" style="background:#16180F;color:#FBF8F2">
          {{ section.settings.button_label | default: 'Join' }}
        </button>
        {%- if form.posted_successfully? -%}
          <p class="small" style="color:rgba(251,248,242,.9);width:100%">Thanks, you're on the list.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stay in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "₹100 off your first order" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "New products, refill drops and the occasional note on what we're reformulating." },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Join" }
  ],
  "presets": [ { "name": "Newsletter band" } ]
}
{% endschema %}
